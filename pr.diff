       taskId: 'planning:plan-session-1',
       cwd: '/repo',
       command: undefined,
       args: undefined,
       mode: 'spawn',
       attached: false,
     });
     expect(taskSession.kind).toBe('task');
     expect(events).toEqual([
       { kind: 'planning', planningSessionId: 'plan-session-1', data: 'planner shell\n' },
     ]);
     expect(bashSpawnFn).toHaveBeenNthCalledWith(
       1,
       '/bin/manual-shell',
       [],
