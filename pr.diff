 function createFakeChild() {
   const ee = new EventEmitter() as EventEmitter & {
     stdout: EventEmitter;
     stderr: EventEmitter;
     stdin: { write: (data: string) => boolean };
     kill: () => void;
     killed: boolean;
     __written: string[];
   };
   ee.stdout = new EventEmitter();
   ee.stderr = new EventEmitter();
   ee.__written = [];
   ee.stdin = {
     write: (data: string) => {
       ee.__written.push(data);
       return true;
     },
   };
   ee.killed = false;
   ee.kill = () => {
     ee.killed = true;
   };
   return ee;
 }
 
