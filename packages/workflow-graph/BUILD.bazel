# Native rules_js targets for @invoker/workflow-graph.
# The :test sh_test wrap stays until the hermetic gates pass and a follow-up deletes it.

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//tools/bazel/workflow-graph-tools:tsup/package_json.bzl", tsup_bin = "bin")
load("@npm//tools/bazel/workflow-graph-tools:vitest/package_json.bzl", vitest_bin = "bin")

exports_files(["package.json"])

_SRCS = glob(
    ["src/**/*.ts"],
    exclude = ["src/**/__tests__/**"],
)

_TESTS = glob(["src/**/__tests__/**/*.ts"])

js_library(
    name = "lib",
    srcs = _SRCS + ["package.json"],
)

tsup_bin.tsup(
    name = "build",
    srcs = _SRCS + [
        "package.json",
        "//tools/bazel/workflow-graph-tools:tsconfig_bazel",
        "//tools/bazel/workflow-graph-tools:node_modules/typescript",
        "//tools/bazel/workflow-graph-tools:node_modules/@types/node",
        "//tools/bazel/workflow-graph-tools:node_modules",
    ],
    outs = [
        "dist/index.js",
        "dist/index.d.ts",
    ],
    args = [
        "src/index.ts",
        "--format",
        "esm",
        "--dts",
        "--tsconfig",
        "../../tools/bazel/workflow-graph-tools/tsconfig.bazel.json",
        "--out-dir",
        "dist",
    ],
    chdir = package_name(),
    env = {
        "NODE_PATH": "../../tools/bazel/workflow-graph-tools/node_modules",
    },
)

vitest_bin.vitest_test(
    name = "unit_tests",
    size = "large",
    args = [
        "run",
        "--config",
        "vitest.bazel.config.ts",
    ],
    chdir = "tools/bazel/workflow-graph-tools",
    data = _SRCS + _TESTS + [
        "package.json",
        "//tools/bazel/workflow-graph-tools:vitest_config",
        "//tools/bazel/workflow-graph-tools:tsconfig_bazel",
        "//packages/execution-engine:src/__tests__/fixtures/pr-6976-oauth-session-expired.ts",
        "//tools/bazel/workflow-graph-tools:node_modules/vitest",
        "//tools/bazel/workflow-graph-tools:node_modules/@types/node",
        "//tools/bazel/workflow-graph-tools:node_modules",
    ],
    no_copy_to_bin = [
        "//packages/execution-engine:src/__tests__/fixtures/pr-6976-oauth-session-expired.ts",
    ],
)

sh_test(
    name = "test",
    size = "large",
    srcs = ["//scripts/bazel:run_pnpm_filter.sh"],
    args = [
        "@invoker/workflow-graph",
        "test",
    ],
    data = glob(
        ["**"],
        exclude = [
            "node_modules/**",
            "dist/**",
            "coverage/**",
            "BUILD.bazel",
        ],
    ),
    tags = [
        "no-sandbox",
        "kind_tsup",
    ],
)
