+  /**
+   * Close a single idle task. CommandService returns the closed task's new
+   * state rather than a launch set, so it is wrapped into the shared
+   * `started` shape: `isDispatchableLaunch` keeps a `closed` task out of
+   * `runnable`, while topup still refills the capacity the close freed.
+   */
+  async closeIdleTask(taskId: string): Promise<MutationResult> {
+    await this.closeReviewForTask(taskId);
+    const started = await this.runViaCommandService(async (cs) => {
+      const result = await cs.closeIdleTask(
+        makeEnvelope('facade.close-idle-task', 'surface', 'task', { taskId }),
+      );
+      return result.ok ? { ok: true as const, data: [result.data] } : result;
+    });
+    return this.finalizeWithTopup(started, 'facade.close-idle-task', { scopedTaskIds: [taskId] });
+  }
