module(
    name = "invoker",
    version = "0.0.0",
)

bazel_dep(name = "aspect_rules_js", version = "2.9.3")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "rules_nodejs", version = "6.3.3")
bazel_dep(name = "bazel_skylib", version = "1.7.1")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.13.0")
use_repo(node, "nodejs_toolchains")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "10.31.0",
)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    data = [
        "//tools/bazel/workflow-graph-tools:package.json",
        "//tools/bazel/workflow-graph-tools:pnpm-workspace.yaml",
    ],
    npmrc = "//tools/bazel/workflow-graph-tools:.npmrc",
    pnpm_lock = "//tools/bazel/workflow-graph-tools:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")
